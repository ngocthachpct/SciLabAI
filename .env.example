DATABASE_URL=            # chuỗi kết nối NeonDB (postgres://...)
GEMINI_API_KEY=          # API key từ Google AI Studio
GEMINI_MODEL=            # tên model Flash hiện hành, VD: gemini-2.0-flash
RATE_LIMIT_PER_MINUTE=10 # số lần gọi AI / IP / phút
FREE_AI_GENERATIONS=1    # số lượt AI miễn phí trọn đời cho mỗi user/IP
GEMINI_MODEL_FALLBACKS=  # danh sách model dự phòng, phân tách bằng dấu phẩy
ALLOW_DEMO_PRO=true      # bật nút nâng cấp Pro demo (không thanh toán thật)
WARM_CACHE_TOKEN=        # token bí mật để script warm-cache bỏ qua quota

# Clerk (https://dashboard.clerk.com) — bắt buộc cho nhánh "Bài của tôi"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
